    "Estimated separately. Docker image layers are shared between images, so removing two images does not free the sum of their sizes. Docker removals cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated separately. Docker image layers are shared between images, so removing two images does not free the sum of their sizes. Docker removals cannot be undone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado separadamente. As camadas de imagem do Docker são compartilhadas entre imagens, então remover duas imagens não libera a soma dos tamanhos delas. Remoções do Docker não podem ser desfeitas."
          }
        }
      }
    },
