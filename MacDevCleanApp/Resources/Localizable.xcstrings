    "An estimate of the space these items occupy. Moving them to the Trash does not free space until you empty the Trash.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An estimate of the space these items occupy. Moving them to the Trash does not free space until you empty the Trash."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma estimativa do espaço que estes itens ocupam. Movê-los para a Lixeira não libera espaço até você esvaziar a Lixeira."
          }
        }
      }
    },
    "An estimate, and kept separate from filesystem totals on purpose. Image layers are shared between images, so removing two images does not free the sum of their sizes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An estimate, and kept separate from filesystem totals on purpose. Image layers are shared between images, so removing two images does not free the sum of their sizes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma estimativa, mantida separada dos totais do sistema de arquivos de propósito. As camadas de imagem são compartilhadas entre imagens, então remover duas imagens não libera a soma dos tamanhos delas."
          }
        }
      }
    },
    "Any risk": {
